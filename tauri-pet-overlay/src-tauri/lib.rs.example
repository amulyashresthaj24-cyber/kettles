// EXAMPLE — how to wire the pet module into your existing src-tauri/src/lib.rs.
// This is a reference, not a drop-in file. Merge the marked lines into yours.

mod pet; // <-- ADD: pulls in src-tauri/src/pet.rs

#[cfg_attr(mobile, tauri::mobile_entry_point)]
pub fn run() {
    tauri::Builder::default()
        // ADD: notification plugin (used by pet_signal on timer finish)
        .plugin(tauri_plugin_notification::init())
        // ...any plugins you already have stay here...
        .invoke_handler(tauri::generate_handler![
            // ...your existing commands...
            // ADD the five pet commands:
            pet::pet_open,
            pet::pet_close,
            pet::pet_signal,
            pet::pet_set_position,
            pet::pet_set_clickthrough,
        ])
        .run(tauri::generate_context!())
        .expect("error while running tauri application");
}

