{
  "_comment": "Single source of truth for the pet overlay. sprite-update-female-clean.png is 950x1661, a 10x11 grid. This overlay positions frames in PERCENT, so cell px are informational only — sheet.cols/rows drive the math.",

  "spritesheet": "assets/sprite-update-female-clean.png",
  "cell":  { "width": 95, "height": 151 },
  "sheet": { "cols": 10, "rows": 11 },
  "scale": 0.85,

  "states": {
    "idle_blink":           { "row": 0,  "frames": 10, "fps": 5,  "loop": true },
    "walking":              { "row": 1,  "frames": 10, "fps": 8,  "loop": true },
    "waving_jumping":       { "row": 2,  "frames": 10, "fps": 8,  "loop": false },
    "sitting_laptop":       { "row": 3,  "frames": 10, "fps": 6,  "loop": true },
    "pointing_presenting":  { "row": 4,  "frames": 10, "fps": 6,  "loop": true },
    "sprinting_fast":       { "row": 5,  "frames": 10, "fps": 12, "loop": true },
    "leaping_celebration":  { "row": 6,  "frames": 10, "fps": 8,  "loop": false },
    "sleeping_afk":         { "row": 7,  "frames": 8,  "fps": 3,  "loop": true },
    "crossed_arms_alert":   { "row": 8,  "frames": 9,  "fps": 6,  "loop": true },
    "coffee_break":         { "row": 9,  "frames": 9,  "fps": 4,  "loop": true },
    "anger_surprise":       { "row": 10, "frames": 10, "fps": 8,  "loop": false }
  },

  "events": {
    "hover":        "waving_jumping",
    "click":        "waving_jumping",
    "doubleClick":  "crossed_arms_alert",
    "timerStart":   "sitting_laptop",
    "timerResume":  "sitting_laptop",
    "timerPause":   "coffee_break",
    "timerBreak":   "coffee_break",
    "timerFinish":  { "play": "leaping_celebration", "then": "idle_blink" },
    "timerAbandon": { "play": "anger_surprise",      "then": "idle_blink" },
    "showQuote":    "pointing_presenting"
  },

  "phaseStates": {
    "idle":     "idle_blink",
    "running":  "sitting_laptop",
    "paused":   "coffee_break",
    "finished": "idle_blink"
  },

  "flashOn": ["timerFinish"]
}
