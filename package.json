{
  "name": "flowmate",
  "version": "1.0.3",
  "private": true,
  "scripts": {
    "dev": "node scripts/free-port.mjs 3000 && next dev -p 3000",
    "build": "next build",
    "agent:hooks": "node scripts/agent-bridge/install-hooks.mjs",
    "agent:hooks:remove": "node scripts/agent-bridge/install-hooks.mjs --remove",
    "check:stable-version": "node scripts/check-stable-version.mjs",
    "validate:pet": "node scripts/pet/validate-pet-atlas.mjs --atlas public/pet/assets/spritesheet.webp --config public/pet/pet.config.json",
    "release:stable-desktop": "powershell -ExecutionPolicy Bypass -File scripts/build-stable-desktop.ps1",
    "start": "node scripts/free-port.mjs 3000 && next start -p 3000",
    "lint": "next lint",
    "tauri": "tauri",
    "tauri:dev": "node scripts/free-desktop.mjs && tauri dev",
    "tauri:build": "set TAURI_ENV_PLATFORM=windows && tauri build",
    "deploy:functions": "supabase functions deploy sessions tasks projects clients analytics report-shares google-calendar",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.105.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.11.0",
    "motion": "^12.40.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.9.1",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^20.19.39",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
