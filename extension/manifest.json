{
  "manifest_version": 3,
  "name": "Kettles Companion",
  "description": "A lightweight Kettles companion for focus awareness, working tags, and local reminders.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Kettles"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/index.html",
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.supabase.co/*"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
